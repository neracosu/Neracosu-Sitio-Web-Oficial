# Sin ejecución de PHP en este directorio (endurecimiento post-hackeo ago-2026)
<FilesMatch "\.(php|php5|php7|php8|phtml)$">
  Require all denied
</FilesMatch>

# La redireccion de /servicios/hoteles.html a /para/hoteles vive en el .htaccess raiz
# desde 2026-10-26: un RewriteEngine aqui anulaba las reglas de URLs sin .html.
